# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL / Railway)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lamsa_db?schema=public"

# Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# Initial Admin Account (created during seed)
ADMIN_EMAIL="admin@lamsa.com"
ADMIN_PASSWORD="ChangeThisPassword@2026"
ADMIN_NAME="LAMSA Admin"

# CORS Allowed Origins (comma-separated or * for development)
CORS_ORIGIN="*"
