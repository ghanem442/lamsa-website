# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL - REQUIRED, no default)
# Get your connection string from Neon, Railway, or your PostgreSQL provider
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Authentication (REQUIRED, no defaults for security)
# Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secure-random-secret-at-least-32-characters-long"
JWT_EXPIRES_IN="7d"

# Initial Admin Account (REQUIRED for seeding database)
# These credentials are used ONLY during the first seed
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD=""
ADMIN_NAME="LAMSA Admin"

# Cloudinary (for image uploads - OPTIONAL)
# Sign up at https://cloudinary.com (free tier: 25GB storage)
# Find these in your Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# CORS Allowed Origins (comma-separated or * for development ONLY)
# For production: set to your actual domain(s), e.g. "https://lamsa.com,https://www.lamsa.com"
# For development: use "*" or "http://localhost:3000"
CORS_ORIGIN="*"

# Rate Limiting for Orders
ORDER_RATE_LIMIT_MAX=5
ORDER_RATE_LIMIT_WINDOW_MINUTES=15

# Rate Limiting for Authentication (stricter to prevent brute force)
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Trust Proxy (for rate limiting behind reverse proxies)
# Values: "loopback" (default, localhost only), 1 (trust first proxy), true (trust all)
# When behind nginx/cloudflare/load balancer, set to: 1 or true
TRUST_PROXY="loopback"
