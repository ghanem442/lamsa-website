# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL - REQUIRED, no default)
# Get your connection string from Neon, Railway, or your PostgreSQL provider
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Authentication (REQUIRED, no defaults for security)
# Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secure-random-secret-at-least-32-characters-long"
JWT_EXPIRES_IN="7d"

# Initial Admin Account (REQUIRED for seeding database)
# These credentials are used ONLY during the first seed
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="YourStrongPassword123!"
ADMIN_NAME="LAMSA Admin"

# CORS Allowed Origins (comma-separated or * for development)
CORS_ORIGIN="*"
