// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  customer
  admin
}

enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  cod
  instapay
  voda
}

model User {
  id             String           @id @default(uuid())
  name           String
  email          String           @unique
  passwordHash   String?          @map("password_hash")
  phone          String?
  role           Role             @default(customer)
  isVerified     Boolean          @default(false) @map("is_verified")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  orders         Order[]
  customPerfumes CustomPerfume[]

  @@map("users")
}

model Product {
  id          String      @id @default(uuid())
  nameAr      String      @map("name_ar")
  nameEn      String      @map("name_en")
  category    String
  subCategory String?     @map("sub_category")
  price       Float
  stockQty    Int         @default(100) @map("stock_qty")
  imageUrl    String?     @map("image_url")
  emoji       String?
  badge       String?     // "popular" | "new"
  skinType    Json?       @map("skin_type") // ["oily", "dry", "combo", "sensitive", "all"]
  concern     Json?       @map("concern")   // ["acne", "dry_skin", "hair_loss", "dull", "wrinkles", "dark_spots", "all"]
  hairType    Json?       @map("hair_type") // ["dry", "oily", "damaged", "normal", "all"]
  budget      Json?       @map("budget")    // ["eco", "mid", "prem"] for routine, OR "low"/"mid"/"high" for gifts
  forWhom     Json?       @map("for_whom")  // ["her", "him", "mom", "friend", "wife", "bride", "all"]
  occasion    Json?       @map("occasion")  // ["bday", "engage", "wedding", "grad", "ramadan", "just", "all"]
  family      String?     // perfume family: "oud", "floral", "musky", "fruity", "woody", "oriental", "fresh"
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  orderItems  OrderItem[]

  @@index([category], map: "idx_products_category")
  @@index([category, subCategory], map: "idx_products_category_subcategory")
  @@index([stockQty], map: "idx_products_stock_qty")
  @@index([badge, createdAt(sort: Desc)], map: "idx_products_badge_created")
  @@map("products")
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique @map("order_number")
  userId        String?       @map("user_id")
  customerName  String        @map("customer_name")
  phone         String
  whatsapp      String?
  city          String
  area          String?
  address       String
  paymentMethod PaymentMethod @default(cod) @map("payment_method")
  orderStatus   OrderStatus   @default(pending) @map("order_status")
  subtotal      Float
  shippingFee   Float         @default(35) @map("shipping_fee")
  totalAmount   Float         @map("total_amount")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  customPerfume CustomPerfume?

  @@index([orderStatus, createdAt(sort: Desc)], map: "idx_orders_status_created")
  @@index([phone], map: "idx_orders_phone")
  @@index([createdAt(sort: Desc)], map: "idx_orders_created_at")
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String   @map("order_id")
  productId     String?  @map("product_id")
  quantity      Int      @default(1)
  unitPrice     Float    @map("unit_price")
  
  // Snapshot fields (preserved even if product is deleted/edited)
  productName   String   @map("product_name")
  productImage  String?  @map("product_image")
  productEmoji  String?  @map("product_emoji")

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId], map: "idx_order_items_order_id")
  @@map("order_items")
}

model CustomPerfume {
  id              String   @id @default(uuid())
  userId          String?  @map("user_id")
  orderId         String?  @unique @map("order_id")
  customName      String?  @map("custom_name")
  topNote         String?  @map("top_note")
  heartNote       String?  @map("heart_note")
  baseNote        String?  @map("base_note")
  size            String   // "30ml" | "50ml" | "100ml"
  concentration   String   // "edt" | "edp" | "extrait"
  calculatedPrice Float    @map("calculated_price")
  createdAt       DateTime @default(now()) @map("created_at")

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("custom_perfumes")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isRead, createdAt(sort: Desc)], map: "idx_contact_messages_read_created")
  @@map("contact_messages")
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  otpCode   String   @map("otp_code")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, expiresAt], map: "idx_otp_email_expires")
  @@map("otps")
}

enum ScentLayer {
  top
  heart
  base
}

model Scent {
  id              String     @id @default(uuid())
  layer           ScentLayer
  nameAr          String     @map("name_ar")
  nameEn          String?    @map("name_en")
  icon            String     @default("🌸")
  description     String     @db.Text
  color           String     @default("#FFE066")
  glowColor       String     @default("rgba(255, 224, 102, 0.5)") @map("glow_color")
  boostSillage    Int?       @map("boost_sillage")
  boostLongevity  Int?       @map("boost_longevity")
  isActive        Boolean    @default(true) @map("is_active")
  sortOrder       Int        @default(0) @map("sort_order")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@index([layer, isActive, sortOrder])
  @@map("scents")
}
